# Emobot 多模型环境变量配置文件
# 支持 OpenAI GPT、Google Gemini 和本地模型的自动切换

# ========== API 密钥配置 ==========
# OpenAI API 配置（如果使用 GPT 模型）
OPENAI_API_KEY=your-openai-api-key-here

# Google Gemini API 配置（如果使用 Gemini 模型）
GOOGLE_API_KEY=AIzaSyBVAnfJ2pBNIliT7N2evGM16c7SZwtiUio

# Anthropic API 配置（如果使用 Claude 模型）
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Hugging Face API 配置（如果使用开源模型）
# HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# ========== 模型配置 ==========
# 默认使用的模型（优先级：openai > gemini > local）
DEFAULT_MODEL=gpt-4

# 模型参数
MODEL_TEMPERATURE=0.7
MAX_TOKENS=2000

# ========== 代理配置（可选）==========
# 如果您在公司网络或需要代理
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1

# ========== 日志配置 ==========
# 日志级别：DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ========== 记忆存储配置 ==========
# 记忆存储目录（默认：agent_memory）
MEMORY_DIR=agent_memory

# ========== MCP 服务器配置 ==========
# MCP 工具服务器地址（默认使用 configs/mcp.yaml 中的配置）
# MCP_SERVER_HOST=127.0.0.1
# MCP_SERVER_PORT=8080

# ========== 工具配置 ==========
# DuckDuckGo 搜索配置
# DUCKDUCKGO_REGION=us-en  # 搜索地区（中文）
# DUCKDUCKGO_SAFESEARCH=moderate  # 安全搜索级别

# ========== 邮件配置（如果要使用真实邮件）==========
# SMTP 服务器配置
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# IMAP 服务器配置
# IMAP_SERVER=imap.gmail.com
# IMAP_PORT=993
# IMAP_USERNAME=your-email@gmail.com
# IMAP_PASSWORD=your-app-password

# ========== 其他配置 ==========
# 时区设置
# TIMEZONE=Asia/Shanghai

# 语言设置
# LANGUAGE=zh-CN

# 开发模式（显示更多调试信息）
# DEBUG_MODE=false 