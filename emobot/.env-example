# Emobot 环境变量配置文件示例
# 请复制此文件为 .env 并根据您的实际情况填写配置
# 命令：cp .env-example .env

# ========== 必需配置 ==========
# 至少需要配置一个 API 密钥

# 1. OpenAI API（使用 GPT 模型）
OPENAI_API_KEY=your-openai-api-key-here

# 2. 或者 Anthropic API（使用 Claude 模型）
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# 3. 或者 Hugging Face API（使用开源模型）
# HUGGINGFACE_API_KEY=your-huggingface-api-key-here

# ========== 可选配置 ==========

# 日志级别
LOG_LEVEL=INFO

# 默认模型（根据您的 API 密钥选择）
DEFAULT_MODEL=gpt-4

# 模型参数
MODEL_TEMPERATURE=0.7
MAX_TOKENS=2000 